generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum CapsuleStatus {
    PENDING
    SENDING
    SENT
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    name      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Capsule {
    id              String        @id @default(cuid())
    recipientEmail  String
    subject         String
    message         String        @db.Text
    paperColor      String
    decoration      String
    stamps          String[]      @default([])
    unlockAt        DateTime
    status          CapsuleStatus @default(PENDING)
    attempts        Int           @default(0)
    nextAttemptAt   DateTime      @default(now())
    sentAt          DateTime?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    @@index([status, unlockAt, nextAttemptAt])
}
